# Файл для /etc/tko-ioo.env; права root:root 600. Значения секретов вводятся на VPS.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PUBLIC_ORIGIN=https://tko.megaev.ru
TKO_PUBLIC_ACCESS=true
MAX_DAILY_REQUESTS=50
USAGE_FILE=/var/lib/tko-ioo/usage.json
# Только если потребуется закрыть сайт паролем:
# TKO_PUBLIC_ACCESS=false
# TKO_USERNAME=tko
# TKO_PASSWORD=
PORT=8787
MAX_CONCURRENT_REQUESTS=2
OPENAI_TIMEOUT_MS=280000
